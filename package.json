{
  "name": "rooftop",
  "version": "1.0.0",
  "description": "Rooftop — a realistic car dealership simulation",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "http-server . -p 8080 -c-1",
    "test:e2e": "tsc -p . && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@playwright/test": "^1.56.1"
  }
}
